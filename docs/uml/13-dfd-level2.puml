@startuml DFD-Level2
skinparam backgroundColor #FBFAF7
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontSize 14
skinparam defaultFontColor #2D2A26
skinparam ArrowColor #5B6E8A
skinparam ArrowThickness 2.0
skinparam componentBackgroundColor #F7F3EB
skinparam componentBorderColor #1B2A4A
skinparam componentBorderThickness 1.8
skinparam componentFontSize 14
skinparam databaseBackgroundColor #E8EDF2
skinparam databaseBorderColor #3A6B8C
skinparam databaseFontSize 13
skinparam actorBackgroundColor #C4A35A
skinparam actorBorderColor #9B7B3A
skinparam actorFontSize 14
skinparam linetype ortho
skinparam nodesep 130
skinparam ranksep 130
skinparam padding 18
scale 1.1

title DFD Level 2 — P1合同管理子系统详细流程

actor "业务人员" as Biz
actor "法务人员" as Legal
actor "LLM引擎" as LLM

rectangle "P1.1\n合同上传\n与接收" as P11 #F7F3EB
rectangle "P1.2\n条款解析\n与拆分" as P12 #F7F3EB
rectangle "P1.3\nAI风险审查" as P13 #F7F3EB
rectangle "P1.4\n审查报告\n生成" as P14 #F7F3EB
rectangle "P1.5\n合同条款\n比对" as P15 #F7F3EB
rectangle "P1.6\n合同草案\nAI生成" as P16 #F7F3EB

database "合同库\n(contracts_store.json)" as D1
database "Prompt模板\n(prompts/·审查规则)" as D2
database "知识索引\n(ChromaDB+Whoosh\n法规检索)" as D3
database "审计日志\n(logs/·追加)" as D4

' ── 业务人员：上传合同 ──
Biz --> P11 : 合同文本·甲乙方·合同类型
P11 --> D1 : 创建合同记录\n{id,title,type,parties,content}
P11 --> Biz : 上传确认·合同编号

' ── 法务人员：审查合同 ──
Legal --> P12 : 发起审查指令
P12 --> D1 : 读取合同文本
P12 --> D2 : 加载审查Prompt模板
P12 --> P13 : 结构化条款列表

P13 --> D3 : 检索相关法规\n(作为审查上下文)
P13 --> LLM : 审查Prompt\n(条款+法条+模板)
LLM --> P13 : 风险等级·法律依据\n修改建议

P13 --> P14 : 带风险标签的审查结果
P14 --> D1 : 更新合同审查状态\n{review_status:已审查}
P14 --> D4 : 追加审查审计日志\n{contract_id,user,model,timestamp}
P14 --> Legal : 审查报告\n(风险分布统计·逐条修改建议)

' ── 法务人员：合同比对 ──
Legal --> P15 : 选择合同A与合同B
P15 --> D1 : 读取两份合同条款
P15 --> P14 : 比对差异数据
P14 --> Legal : 比对结果\n(形式差异·实质差异)

' ── 法务人员：合同生成 ──
Legal --> P16 : 合同类型·关键条款要求
P16 --> D2 : 加载合同生成Prompt
P16 --> LLM : 生成Prompt
LLM --> P16 : 合同草案文本
P16 --> D1 : 保存生成的合同
P16 --> Legal : 合同草案\n(标注AI生成·仅供参考)

' ── 业务人员：接收通知 ──
P14 --> Biz : 审查完成通知

@enduml
