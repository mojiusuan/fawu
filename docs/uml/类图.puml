@startuml 类图
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 3
skinparam defaultFontSize 13
skinparam ArrowColor #1B2A4A
skinparam ArrowThickness 1.8
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #5B6E8A
skinparam classBorderThickness 1.5
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam classHeaderBackgroundColor #E8EDF2
skinparam classHeaderFontColor #1B2A4A
skinparam classHeaderFontSize 14
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #5B6E8A
skinparam packageFontSize 14
skinparam packageFontStyle bold
skinparam linetype ortho
skinparam nodesep 95
skinparam ranksep 105
skinparam padding 14
scale 1.05

title 智能法务系统 — 核心类图

package "认证授权" #E8EDF2 {
  class UserInfo {
    + id : str
    + username : str
    + role : Role
    + created_at : datetime
  }

  enum Role {
    admin
    legal
    business
    auditor
  }

  class UserStore {
    + get_by_username(username) : UserInfo
    + create_user(...) : UserInfo
    + list_users() : list[UserInfo]
    + delete_user(id) : bool
  }
}

package "合同管理" #F5F0E8 {
  enum RiskLevel {
    high
    medium
    low
    none
  }

  class ContractInfo {
    + id : str
    + title : str
    + contract_type : str
    + party_a : str
    + party_b : str
    + content : text
    + review_status : str
    + clauses : ClauseInfo[]
    + created_at : datetime
  }

  class ClauseInfo {
    + clause_number : str
    + content : text
    + risk_level : RiskLevel
    + risk_analysis : str
    + law_basis : str
    + suggestion : str
  }

  class ContractService {
    + create_contract(...) : ContractInfo
    + get_contract(id) : ContractInfo
    + list_contracts() : list
    + parse_clauses(text) : ClauseInfo[]
    + build_review_result(...) : ReviewResult
  }

  class ContractAgent {
    - client : LLMClient
    + review_contract(...) : tuple
    + compare_contracts(...) : list
    + generate_contract(...) : str
  }

  class ContractReviewResult {
    + high_risks : int
    + medium_risks : int
    + low_risks : int
    + clauses : ClauseInfo[]
    + audit_id : str
  }
}

package "法律咨询" #DCE5D8 {
  class ConsultationService {
    + add_history(q, s) : void
    + get_history() : list
  }

  class ConsultationAgent {
    - client : LLMClient
    + ask(question, source, user) : tuple
  }

  class AskResponse {
    + answer : str
    + search_results : list
    + law_basis : list[str]
    + audit_id : str
  }

  class ConsultationHistory {
    + id : str
    + question : text
    + answer_summary : text
    + timestamp : datetime
  }
}

package "RAG 检索引擎" #D6E0EB {
  class HybridRetriever {
    - _chroma_client
    - _whoosh_index
    + search(query, type, top_k) : list
    + index_documents(chunks) : int
    + search_laws(query, k) : list
    + search_cases(query, k) : list
  }

  class EmbeddingService {
    - client : LLMClient
    + embed_query(text) : vector
    + embed_chunks(chunks) : list[vector]
  }

  class CitationFormatter {
    + format_search_result(r) : dict
    + format_law_citation(r) : str
  }

  class LegalDocumentParser {
    + parse(file_path) : list
    + parse_to_documents(path) : list
  }
}

package "Agent 编排" #F0ECF5 {
  class AgentOrchestrator {
    - client : LLMClient
    - graph : StateGraph
    + run(user_input) : dict
  }

  class AgentState {
    + user_input : str
    + task_type : str
    + next_agent : str
    + context : dict
    + result : str
    + finished : bool
  }

  class RPAAgent {
    - client : LLMClient
    + extract_contract_data(path) : dict
    + fill_form(fields, data) : dict
  }
}

package "案件分析" #FDF8ED {
  class CaseService {
    + create(user, name, type, desc) : dict
    + get(id) : dict
    + list_by_user(uid, status) : list
    + update(id, ...) : dict
    + delete(id) : bool
  }

  class CaseAnalyzer {
    - client : LLMClient
    + analyze(type, facts, id, user) : dict
    + get_analysis(id) : dict
  }

  class CaseMatcher {
    + match_by_case_type(type, facts) : list
    + rerank_cases(query, rag, kg) : list
  }

  class CaseProfileInfo {
    + case_id : str
    + case_name : str
    + case_type : str
    + description : text
    + status : str
    + structured_facts : dict
  }
}

package "知识图谱" #E8D5C0 {
  class GraphBuilder {
    - driver : Neo4jDriver
    + build_from_documents(docs) : int
    + create_entity(type, props) : str
    + create_relationship(...) : void
    + get_stats() : dict
  }

  class KnowledgeExtractor {
    - client : LLMClient
    + extract_from_text(text) : dict
    + extract_from_contract(title, clauses) : dict
    + extract_from_case(data) : dict
  }

  class KGQuery {
    + is_available : bool
    + search_fulltext(keyword) : list
    + query_entity(type, id) : dict
    + find_case_precedents(article) : list
  }
}

package "审计服务" #F0EDE5 {
  class AuditLogger {
    + log(user, task, model, ...) : str
    + log_rag_query(q, source, count) : void
    + get_all_logs(limit) : list
    + get_stats() : dict
  }

  class AuditReporter {
    + generate_report() : str
    + export(format) : str
  }
}

package "基础设施" #F7F3EB {
  class LLMClient {
    - provider : str
    - model : str
    + generate(system, user, temp) : tuple
    + embed_query(text) : vector
    + embed_texts(texts) : list[vector]
  }

  class Settings {
    + LLM_PROVIDER : str
    + llm_model : str
    + NEO4J_URI : str
    + JWT_SECRET_KEY : str
    + ensure_directories() : void
  }
}

' ═══════════════ 关系 ═══════════════
' 泛化 Generalization       ————▷  子类→父类（实线+空心三角）
' 依赖 Dependency           ----▷  使用类→被依赖类（虚线+箭头）
' 关联 Association          ————▷  单向关联（实线+箭头）
' 组合 Composition          ◆————  部分→整体（实线+实心菱形）
' 聚合 Aggregation          ◇————  部分→整体（实线+空心菱形）

' ── 认证授权 ──
UserInfo "1" ..> "1" Role : 类型引用
UserStore "1" --> "0..*" UserInfo : 管理

' ── 用户关联各业务模块 ──
UserInfo "1" ..> "0..*" ContractService : 发起
UserInfo "1" ..> "0..*" ConsultationService : 发起
UserInfo "1" ..> "0..*" CaseService : 发起
UserInfo "1" ..> "0..*" AuditLogger : 操作追溯

' ── 全局配置 ──
Settings "1" ..> "1" LLMClient : 创建与配置

' ── 合同管理 ──
ContractService "1" --> "1" ContractAgent : 委托审查
ContractService "1" --> "0..*" ContractInfo : 管理
ContractInfo "1" *-- "1..*" ClauseInfo : 组合（内嵌JSON）
ClauseInfo "0..*" ..> "1" RiskLevel : 类型引用
ContractService "1" ..> "0..*" ContractReviewResult : 产出
ContractAgent "1" ..> "1" LLMClient : 调用

' ── 法律咨询 ──
ConsultationService "1" --> "1" ConsultationAgent : 委托问答
ConsultationService "1" --> "0..*" ConsultationHistory : 管理
ConsultationAgent "1" ..> "1" LLMClient : 调用
ConsultationAgent "1" --> "1" HybridRetriever : RAG检索

' ── 案件分析 ──
CaseService "1" --> "1" CaseAnalyzer : 委托分析
CaseService "1" --> "1" CaseMatcher : 委托匹配
CaseService "1" --> "0..*" CaseProfileInfo : 管理
CaseAnalyzer "1" ..> "1" LLMClient : 调用

' ── RAG 引擎 ──
HybridRetriever "1" --> "1" EmbeddingService : 向量化
HybridRetriever "1" --> "1" CitationFormatter : 格式化
EmbeddingService "1" ..> "1" LLMClient : 调用

' ── Agent 编排 ──
AgentOrchestrator "1" ..> "1" LLMClient : 调用
AgentOrchestrator "1" --> "1..*" AgentState : 管理状态
RPAAgent "1" ..> "1" LLMClient : 调用

' ── 知识图谱 ──
GraphBuilder "1" --> "1" KnowledgeExtractor : 实体抽取
KnowledgeExtractor "1" ..> "1" LLMClient : 调用
GraphBuilder "1" --> "1" KGQuery : 填充索引

' ── 审计 ──
AuditLogger "1" ..> "0..*" ContractAgent : 记录
AuditLogger "1" ..> "0..*" ConsultationAgent : 记录
AuditLogger "1" ..> "0..*" HybridRetriever : 记录

@enduml
