# ==========================================
# 智能法务系统 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ==========================================

# --- LLM API Keys ---
# Claude API (Anthropic) - 法律领域推荐
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OpenAI API - GPT-4o 和 Embedding 使用
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DeepSeek API - 高性价比中文模型
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- LLM 模型配置 ---
# 默认模型: claude / openai / deepseek
LLM_PROVIDER=deepseek
# Claude 模型: claude-opus-4-20250514 / claude-sonnet-4-20250514
CLAUDE_MODEL=claude-sonnet-4-20250514
# OpenAI 模型: gpt-4o / gpt-4o-mini
OPENAI_MODEL=gpt-4o
# DeepSeek 模型: deepseek-chat (V3) / deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat
# Embedding: local (免费本地中文模型) / openai (需 API Key)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-large-zh-v1.5
# 默认参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Neo4j 知识图谱 ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=legaladmin123

# --- ChromaDB 向量数据库 ---
CHROMA_PERSIST_DIR=./chroma_db

# --- 应用配置 ---
APP_NAME=智能法务系统
APP_VERSION=1.0.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- 模型下载 ---
# HuggingFace 镜像（国内用户建议用 https://hf-mirror.com）
HF_ENDPOINT=https://huggingface.co

# --- 日志 ---
LOG_LEVEL=INFO
AUDIT_LOG_DIR=./logs
EXPORT_DIR=./exports

# --- 知识库路径 ---
KNOWLEDGE_BASE_DIR=./knowledge
