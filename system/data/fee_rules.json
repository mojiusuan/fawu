      {"max": null, "rate": 0.005, "description": "超过10万元（按0.5%交纳）"}
    ],
    "max_fee": 5000,
    "note": "申请保全费最多不超过5000元"
  },
  "execution_fee": {
    "title": "申请执行费",
    "legal_basis": "《诉讼费用交纳办法》第十四条",
