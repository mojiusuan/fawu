      {"max": 20000000, "rate": 0.006, "description": "超过1000万元至2000万元"},
      {"max": null, "rate": 0.005, "description": "超过2000万元"}
    ],
    "reduction_policy": {
      "summary": "符合条件可申请减免",
      "conditions": [
        "适用简易程序审理的案件减半交纳",
        "以调解方式结案或当事人申请撤诉的减半交纳",
        "符合司法救助条件的可申请缓交、减交或免交"
      ]
    }
  },
  "preservation_fee": {
    "title": "申请保全费",
    "legal_basis": "《诉讼费用交纳办法》第十四条",
    "description": "申请财产保全措施需交纳的费用",
    "tiers": [
      {"max": 1000, "fixed": 30, "description": "财产数额不超过1000元"},
