      {"max": 200000, "rate": 0.02, "description": "超过10万元至20万元"},
      {"max": 500000, "rate": 0.015, "description": "超过20万元至50万元"},
      {"max": 1000000, "rate": 0.01, "description": "超过50万元至100万元"},
      {"max": 2000000, "rate": 0.009, "description": "超过100万元至200万元"},
      {"max": 5000000, "rate": 0.008, "description": "超过200万元至500万元"},
