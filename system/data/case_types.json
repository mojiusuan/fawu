      "fields": [
        {"key": "purchase_date", "label": "购买日期", "type": "date", "required": true},
        {"key": "purchase_amount", "label": "购买金额（元）", "type": "number", "required": true},
        {"key": "product_type", "label": "商品/服务类型", "type": "text", "required": true},
        {"key": "issue_type", "label": "问题类型", "type": "select", "required": true, "options": ["质量问题", "虚假宣传", "价格欺诈", "食品安全", "拒绝退换", "个人信息泄露", "其他"]},
        {"key": "has_receipt", "label": "是否有购物凭证", "type": "boolean", "required": true},
        {"key": "description", "label": "详细案情描述", "type": "textarea", "required": true}
      ],
      "limitation_type": "general",
      "limitation_period_days": 1095
    },
    "property": {
      "name": "房产纠纷",
      "description": "房屋买卖纠纷、租赁纠纷、物业纠纷、拆迁补偿等",
      "fields": [
        {"key": "property_type", "label": "房产类型", "type": "select", "required": true, "options": ["商品房", "二手房", "租赁房", "商业用房", "宅基地", "其他"]},
        {"key": "transaction_date", "label": "交易/租赁日期", "type": "date", "required": false},
        {"key": "amount_involved", "label": "涉及金额（元）", "type": "number", "required": true},
        {"key": "dispute_type", "label": "纠纷类型", "type": "select", "required": true, "options": ["买卖合同纠纷", "逾期交房", "房屋质量", "租赁合同纠纷", "物业纠纷", "拆迁补偿", "产权争议", "其他"]},
        {"key": "has_contract", "label": "是否有书面合同", "type": "boolean", "required": true},
        {"key": "description", "label": "详细案情描述", "type": "textarea", "required": true}
      ],
      "limitation_type": "general",
      "limitation_period_days": 1095
    },
    "contract": {
      "name": "合同纠纷",
      "description": "买卖合同、服务合同、租赁合同等各类合同违约纠纷",
      "fields": [
        {"key": "contract_type", "label": "合同类型", "type": "select", "required": true, "options": ["买卖合同", "服务合同", "租赁合同", "承揽合同", "委托合同", "合伙协议", "其他"]},
        {"key": "sign_date", "label": "合同签署日期", "type": "date", "required": true},
        {"key": "contract_amount", "label": "合同金额（元）", "type": "number", "required": true},
