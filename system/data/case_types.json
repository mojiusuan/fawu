        {"key": "incident_location", "label": "事发地点", "type": "text", "required": true},
        {"key": "injury_description", "label": "受伤情况", "type": "textarea", "required": true},
        {"key": "medical_cost", "label": "已发生医疗费用（元）", "type": "number", "required": true},
        {"key": "disability_level", "label": "伤残等级（如有鉴定）", "type": "select", "required": false, "options": ["未鉴定", "一级", "二级", "三级", "四级", "五级", "六级", "七级", "八级", "九级", "十级"]},
        {"key": "liability_determined", "label": "责任是否已认定", "type": "boolean", "required": false},
        {"key": "lost_income", "label": "误工损失（元）", "type": "number", "required": false},
        {"key": "description", "label": "详细案情描述", "type": "textarea", "required": true}
      ],
      "limitation_type": "general",
      "limitation_period_days": 1095
    },
    "marriage": {
