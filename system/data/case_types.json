{
  "case_types": {
    "labor": {
      "name": "劳动争议",
      "description": "劳动合同纠纷、工资争议、解除劳动合同、工伤认定等",
      "fields": [
        {"key": "employment_start", "label": "入职日期", "type": "date", "required": true},
        {"key": "employment_end", "label": "离职日期（如有）", "type": "date", "required": false},
        {"key": "monthly_salary", "label": "月工资标准（元）", "type": "number", "required": true},
        {"key": "dispute_type", "label": "争议类型", "type": "select", "required": true, "options": ["欠薪", "违法解除", "经济补偿", "工伤认定", "加班费", "社保争议", "竞业限制", "其他"]},
        {"key": "has_contract", "label": "是否有书面劳动合同", "type": "boolean", "required": true},
        {"key": "claim_amount", "label": "诉求金额（元）", "type": "number", "required": false},
        {"key": "description", "label": "详细案情描述", "type": "textarea", "required": true}
      ],
      "limitation_type": "labor_arbitration",
      "limitation_period_days": 365
    },
    "loan": {
      "name": "民间借贷",
      "description": "个人之间借款纠纷、利息争议、担保纠纷等",
