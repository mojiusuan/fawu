        {"key": "loan_date", "label": "借款日期", "type": "date", "required": true},
        {"key": "loan_amount", "label": "借款金额（元）", "type": "number", "required": true},
        {"key": "agreed_interest", "label": "约定利率（年化%，未约定填 0）", "type": "number", "required": true},
        {"key": "repayment_deadline", "label": "约定还款日期", "type": "date", "required": false},
        {"key": "has_io_u", "label": "是否有借条/借据", "type": "boolean", "required": true},
        {"key": "has_transfer_record", "label": "是否有转账记录", "type": "boolean", "required": true},
        {"key": "repaid_amount", "label": "已还金额（元）", "type": "number", "required": false},
